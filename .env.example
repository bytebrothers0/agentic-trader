# Copy to .env and fill in. Never commit .env.
#
# LLM_PROVIDER selects the SHARED provider:
#   groq  | xai  — a hosted keyed provider (set the matching *_API_KEY)
#   local        — an OpenAI-compatible endpoint (LOCAL_* below). Keyless by
#                  default (no Authorization header; the endpoint injects its own
#                  upstream credential). Set LOCAL_API_KEY_ENV to the NAME of an
#                  env var (e.g. OPENCODE_API_KEY) when the endpoint wants the
#                  client's own key — a proxy that authenticates the client.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4
# Local endpoint (LLM_PROVIDER=local). BASE_URL is the base — the client appends
# /chat/completions — but a full ".../v1/chat/completions" is tolerated.
LOCAL_BASE_URL=http://localhost:8080/v1
LOCAL_MODEL=glm-5.3-flash-free
# Blank = keyless. Set to OPENCODE_API_KEY to send `Authorization: Bearer <key>`.
LOCAL_API_KEY_ENV=
OPENCODE_API_KEY=
TAVILY_API_KEY=
AI_MODE=propose
AI_MOCK=false
AI_MIN_CONFIDENCE=55
AI_MAX_RISK_PERCENT=1.0
AI_SYMBOL=XAUUSD

# --- Agentic chart agent (agentic/ + agent_service.py) -------------------------
# The AGENT_* knobs live in config/settings.py, NOT here. What matters here is the
# shared provider they inherit: in AGENT_MODE="live" an empty AGENT_MODEL /
# AGENT_API_BASE / AGENT_API_KEY_ENV means "use LLM_PROVIDER below", so the agent
# reuses GROQ_*/XAI_*/LOCAL_* by default and needs no key of its own. With
# LLM_PROVIDER=local the agent inherits LOCAL_BASE_URL/LOCAL_MODEL and, if
# LOCAL_API_KEY_ENV is set, sends that key as the Authorization header too.
#
# Live mode needs a VISION-capable model. With LLM_PROVIDER=groq the shipped
# default qwen/qwen3.8-27b can see the rendered chart; a text-only model (e.g.
# openai/gpt-oss-120b) cannot, so do not set one here if the agent runs live.
#
# Every live request carries AGENT_HTTP_USER_AGENT ("trading-bot-agent/1.0").
# urllib's default "Python-urllib/3.x" is rejected by Cloudflare with HTTP 403 /
# error 1010 before authentication, so live mode fails without an explicit UA.
