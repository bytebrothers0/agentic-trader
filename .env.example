# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4
TAVILY_API_KEY=
AI_MODE=propose
AI_MOCK=false
AI_MIN_CONFIDENCE=55
AI_MAX_RISK_PERCENT=1.0
AI_SYMBOL=XAUUSD

# --- Agentic chart agent (agentic/ + agent_service.py) -------------------------
# The AGENT_* knobs live in config/settings.py, NOT here. What matters here is the
# shared provider they inherit: in AGENT_MODE="live" an empty AGENT_MODEL /
# AGENT_API_BASE / AGENT_API_KEY_ENV means "use LLM_PROVIDER below", so the agent
# reuses GROQ_*/XAI_* by default and needs no key of its own.
#
# Live mode needs a VISION-capable GROQ_MODEL. The shipped default above is
# qwen/qwen3.8-27b, which can see the rendered chart; a text-only model (e.g.
# openai/gpt-oss-120b) cannot, so do not set one here if the agent runs live.
#
# Every live request carries AGENT_HTTP_USER_AGENT ("trading-bot-agent/1.0").
# urllib's default "Python-urllib/3.x" is rejected by Cloudflare with HTTP 403 /
# error 1010 before authentication, so live mode fails without an explicit UA.
